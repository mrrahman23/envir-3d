# Public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://envir.com

# Contact form delivery — configure ONE of the options below.
# Without either, /api/contact answers 503 "not_configured" and the form offers e-mail instead.

# Option A: e-mail via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=post@envir.com
# Must be a sender on a domain verified in Resend, e.g. "Envir nettside <nettside@envir.com>"
CONTACT_FROM_EMAIL=

# Option B: POST the submission as JSON to a webhook (CRM, Make/Zapier, Slack workflow …)
CONTACT_WEBHOOK_URL=
